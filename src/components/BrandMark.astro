---
// The canonical Wollack Systems mark, inlined from the single path in
// src/lib/brand.ts so no copy of the shape can drift. Inline (rather than an
// <img>) so CSS can tint it, and because the mark is one small path.
//
// Decorative by default: pass `label` only where the mark is the sole carrier
// of the brand name, which renders it as a labelled image instead of hiding
// it from assistive tech.
import { MARK_PATH, MARK_VIEW_BOX } from '../lib/brand';

interface Props {
  /** Rendered width and height in px; the mark is square. */
  size?: number;
  /** Accessible name. Omit when adjacent text already names the brand. */
  label?: string;
  class?: string;
}

const { size = 30, label, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={MARK_VIEW_BOX}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={MARK_PATH} />
</svg>
